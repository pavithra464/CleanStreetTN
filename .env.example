# =============================================================================
# CleanStreet TN — Environment Variables
# =============================================================================
# If left blank, CleanStreet TN automatically operates in resilient local
# demonstration mode with simulated persistent storage and demo data.
#
# To connect to live Supabase PostgreSQL & Storage:
# 1. Create a Supabase project at https://supabase.com
# 2. Run the SQL migration in supabase/migrations/20261028_cleanstreet_init.sql
# 3. Create a public Storage bucket named 'report-photos'
# 4. Paste your Project URL and public anon key below:

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
